        "text": "消息"
      },
      {
        "pagePath": "pages/organization/organization",
        "iconPath": "static/images/organization.png",
        "selectedIconPath": "static/images/organization-active.png",
        "text": "组织"
      },
      {
        "pagePath": "pages/profile/profile",
