        "selectedIconPath": "static/images/profile-active.png",
        "text": "我的"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-ui/components/u-$1/u-$1.vue",
      "^u-(.+)--(.+)": "uview-ui/components/u-$1/u-$1.vue",
      "^business-(.*)": "@/components/business/$1/$1.vue"
