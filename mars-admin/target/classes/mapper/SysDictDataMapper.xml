<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mars.admin.mapper.SysDictDataMapper">

    <!-- 字典数据基础信息结果映射 -->
    <resultMap id="SysDictDataResult" type="com.mars.admin.entity.SysDictData">
        <id property="id" column="dict_data_id"/>
        <result property="dictSort" column="dict_sort"/>
        <result property="dictLabel" column="dict_label"/>
        <result property="dictValue" column="dict_value"/>
        <result property="dictType" column="dict_type"/>
        <result property="cssClass" column="css_class"/>
        <result property="listClass" column="list_class"/>
        <result property="isDefault" column="is_default"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="deleteTime" column="delete_time"/>
    </resultMap>

    <!-- 分页查询字典数据列表 -->
    <select id="selectDictDataList" parameterType="com.mars.admin.entity.SysDictData" resultMap="SysDictDataResult">
        SELECT
            dd.id as dict_data_id,
            dd.dict_sort,
            dd.dict_label,
            dd.dict_value,
            dd.dict_type,
            dd.css_class,
            dd.list_class,
            dd.is_default,
            dd.status,
            dd.remark,
            dd.create_time,
            dd.update_time,
            dd.create_by,
            dd.update_by,
            dd.is_deleted,
            dd.delete_time
        FROM sys_dict_data dd
        WHERE dd.is_deleted = 0
        <if test="dictType != null and dictType != ''">
            AND dd.dict_type = #{dictType}
        </if>
        <if test="dictLabel != null and dictLabel != ''">
            AND dd.dict_label LIKE CONCAT('%', #{dictLabel}, '%')
        </if>
        <if test="status != null">
            AND dd.status = #{status}
        </if>
        ORDER BY dd.dict_sort ASC, dd.create_time DESC
    </select>

    <!-- 根据字典类型查询字典数据 -->
    <select id="selectDictDataByType" parameterType="String" resultMap="SysDictDataResult">
        SELECT
            dd.id as dict_data_id,
            dd.dict_sort,
            dd.dict_label,
            dd.dict_value,
            dd.dict_type,
            dd.css_class,
            dd.list_class,
            dd.is_default,
            dd.status,
            dd.remark,
            dd.create_time,
            dd.update_time,
            dd.create_by,
            dd.update_by,
            dd.is_deleted,
            dd.delete_time
        FROM sys_dict_data dd
        WHERE dd.dict_type = #{dictType} AND dd.is_deleted = 0 AND dd.status = 1
        ORDER BY dd.dict_sort ASC
    </select>

</mapper> 