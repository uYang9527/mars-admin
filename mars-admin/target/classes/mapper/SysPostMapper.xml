<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mars.admin.mapper.SysPostMapper">

    <!-- 岗位基础信息结果映射 -->
    <resultMap id="SysPostResult" type="com.mars.admin.entity.SysPost">
        <id property="id" column="post_id"/>
        <result property="postCode" column="post_code"/>
        <result property="postName" column="post_name"/>
        <result property="postSort" column="post_sort"/>
        <result property="status" column="status"/>
        <result property="isSystem" column="is_system"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="deleteTime" column="delete_time"/>
    </resultMap>

    <!-- 分页查询岗位列表 -->
    <select id="selectPostList" parameterType="com.mars.admin.entity.SysPost" resultMap="SysPostResult">
        SELECT
            p.id as post_id,
            p.post_code,
            p.post_name,
            p.post_sort,
            p.status,
            p.is_system,
            p.remark,
            p.create_time,
            p.update_time,
            p.create_by,
            p.update_by,
            p.is_deleted,
            p.delete_time
        FROM sys_post p
        WHERE p.is_deleted = 0
        <if test="postName != null and postName != ''">
            AND p.post_name LIKE CONCAT('%', #{postName}, '%')
        </if>
        <if test="postCode != null and postCode != ''">
            AND p.post_code LIKE CONCAT('%', #{postCode}, '%')
        </if>
        <if test="status != null">
            AND p.status = #{status}
        </if>
        ORDER BY p.post_sort ASC, p.create_time DESC
    </select>

    <!-- 根据用户ID查询岗位列表 -->
    <select id="selectPostsByUserId" parameterType="Long" resultMap="SysPostResult">
        SELECT
            p.id as post_id,
            p.post_code,
            p.post_name,
            p.post_sort,
            p.status,
            p.is_system,
            p.remark,
            p.create_time,
            p.update_time,
            p.create_by,
            p.update_by,
            p.is_deleted,
            p.delete_time
        FROM sys_post p
        INNER JOIN sys_user_post up ON p.id = up.post_id
        WHERE p.is_deleted = 0 AND p.status = 1 AND up.user_id = #{userId}
        ORDER BY p.post_sort ASC
    </select>

</mapper> 