<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mars.admin.mapper.SysOperLogMapper">

    <!-- 操作日志基础信息结果映射 -->
    <resultMap id="SysOperLogResult" type="com.mars.admin.entity.SysOperLog">
        <id property="id" column="oper_id"/>
        <result property="title" column="title"/>
        <result property="businessType" column="business_type"/>
        <result property="method" column="method"/>
        <result property="requestMethod" column="request_method"/>
        <result property="operatorType" column="operator_type"/>
        <result property="operName" column="oper_name"/>
        <result property="deptName" column="dept_name"/>
        <result property="operUrl" column="oper_url"/>
        <result property="operIp" column="oper_ip"/>
        <result property="operLocation" column="oper_location"/>
        <result property="operParam" column="oper_param"/>
        <result property="jsonResult" column="json_result"/>
        <result property="status" column="status"/>
        <result property="errorMsg" column="error_msg"/>
        <result property="operTime" column="oper_time"/>
        <result property="costTime" column="cost_time"/>
    </resultMap>

    <!-- 分页查询操作日志列表 -->
    <select id="selectOperLogList" parameterType="com.mars.admin.entity.SysOperLog" resultMap="SysOperLogResult">
        SELECT
            ol.id as oper_id,
            ol.title,
            ol.business_type,
            ol.method,
            ol.request_method,
            ol.operator_type,
            ol.oper_name,
            ol.dept_name,
            ol.oper_url,
            ol.oper_ip,
            ol.oper_location,
            ol.oper_param,
            ol.json_result,
            ol.status,
            ol.error_msg,
            ol.oper_time,
            ol.cost_time
        FROM sys_oper_log ol
        WHERE 1=1
        <if test="title != null and title != ''">
            AND ol.title LIKE CONCAT('%', #{title}, '%')
        </if>
        <if test="businessType != null">
            AND ol.business_type = #{businessType}
        </if>
        <if test="operName != null and operName != ''">
            AND ol.oper_name LIKE CONCAT('%', #{operName}, '%')
        </if>
        <if test="status != null">
            AND ol.status = #{status}
        </if>
        ORDER BY ol.oper_time DESC
    </select>

</mapper> 