<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.0.5</version>
        <relativePath/>
    </parent>

    <groupId>com.mars</groupId>
    <artifactId>mars-admin</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mars-admin</name>

    <description>中小企业快速开发脚手架</description>
    <url>https://gitee.com/marsFactory/mars-admin</url>

    <organization>
        <name>程序员Mars</name>
        <url>https://www.marsadmin.cn</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>mars</id>
            <name>程序员Mars</name>
            <email>wqexpore@163.com</email>
            <organization>火星网络科技</organization>
            <organizationUrl>https://www.marsadmin.cn</organizationUrl>
        </developer>
    </developers>


    <properties>
        <!-- Java 编译版本设置，这里设置为 Java 17 -->
        <java.version>17</java.version>

        <!-- Maven 编译器插件使用的 Java 源代码版本 -->
        <maven.compiler.source>17</maven.compiler.source>

        <!-- Maven 编译器插件生成的 class 文件的目标版本 -->
        <maven.compiler.target>17</maven.compiler.target>

        <!-- MyBatis-Flex 版本号（轻量级 MyBatis 增强框架） -->
        <mybatis-flex.version>1.10.9</mybatis-flex.version>

        <!-- Sa-Token 版本号（Java 权限认证框架） -->
        <sa-token.version>1.38.0</sa-token.version>

        <!-- Knife4j 版本号（Swagger 的增强 UI 框架） -->
        <knife4j.version>4.4.0</knife4j.version>

        <!-- Fastjson2 版本号（阿里巴巴开源的高性能 JSON 解析器） -->
        <fastjson2.version>2.0.43</fastjson2.version>

        <!-- Druid 版本号（阿里巴巴开源的数据库连接池） -->
        <druid.version>1.2.23</druid.version>

        <!-- Oshi 版本号（Java 硬件信息监控库） -->
        <oshi.version>6.4.0</oshi.version>

        <!-- Hutool 版本号（国产 Java 工具库） -->
        <hutool.version>5.8.20</hutool.version>
    </properties>


    <dependencies>

        <!-- Spring Web 模块，支持构建 RESTful API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MyBatis-Flex：轻量高性能 ORM 框架 -->
        <dependency>
            <groupId>com.mybatis-flex</groupId>
            <artifactId>mybatis-flex-spring-boot-starter</artifactId>
            <version>${mybatis-flex.version}</version>
        </dependency>

        <!-- MySQL 连接驱动（支持 Spring Boot 3） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 阿里 Druid 数据库连接池（适配 Spring Boot 3） -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
            <version>${druid.version}</version>
        </dependency>

        <!-- Lombok 注解工具，简化 Java 代码（如 Getter/Setter 等） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- FastJSON2：阿里巴巴开源的高性能 JSON 序列化框架 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>${fastjson2.version}</version>
        </dependency>

        <!-- FastJSON2 Spring6 扩展：用于替代 Jackson 作为默认 JSON 解析器 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2-extension-spring6</artifactId>
            <version>${fastjson2.version}</version>
        </dependency>

        <!-- Spring Boot 单元测试支持 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- YAML 解析器（支持 YAML 配置文件的读取） -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <!-- Knife4j：Swagger 接口文档增强工具（兼容 Spring Boot 3） -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>${knife4j.version}</version>
        </dependency>

        <!-- Sa-Token 权限认证框架（支持登录鉴权、权限控制） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>

        <!-- Sa-Token + Redis 整合（Jackson序列化） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
            <version>${sa-token.version}</version>
        </dependency>

        <!-- Redis 连接池（Spring Redis 默认使用 commons-pool2） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- Spring Boot Redis 模块 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 参数校验模块，支持 @Valid / @Validated 等注解 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Boot AOP 模块（用于切面编程，如日志记录、权限控制等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Servlet API（Spring Boot 3 基于 Jakarta EE） -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Boot 缓存支持（用于缓存注解、Redis缓存等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- MinIO 客户端：支持对象存储（对标 S3） -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.2</version>
        </dependency>

        <!-- 阿里云 OSS 文件存储 SDK -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>3.17.4</version>
        </dependency>

        <!-- OkHttp 网络请求库（MinIO 依赖使用） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.11.0</version>
        </dependency>

        <!-- Apache POI 支持导出 Excel（xls、xlsx） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.2.3</version>
        </dependency>

        <!-- Apache POI 对应 Office 2007+ 格式（.xlsx 文件） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.3</version>
        </dependency>

        <!-- OSHI：Java 系统硬件信息工具（如CPU、内存、磁盘监控） -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
            <version>${oshi.version}</version>
        </dependency>

        <!-- Hutool：国产 Java 工具包，功能丰富，提升开发效率 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>

    </dependencies>


    <profiles>
        <!-- 开发环境 -->
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <env>dev</env>
            </properties>
        </profile>

        <!-- 生产环境 -->
        <profile>
            <id>prod</id>
            <properties>
                <env>prod</env>
            </properties>
        </profile>
    </profiles>


    <build>
        <!-- 打包后的文件名称 -->
        <finalName>mars-admin</finalName>

        <plugins>
            <!-- Spring Boot 打包插件 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Maven 编译插件 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>


</project>
