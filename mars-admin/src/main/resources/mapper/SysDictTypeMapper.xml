<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mars.admin.modules.system.mapper.SysDictTypeMapper">

    <!-- 字典类型基础信息结果映射 -->
    <resultMap id="SysDictTypeResult" type="com.mars.admin.modules.system.entity.SysDictType">
        <id property="id" column="dict_type_id"/>
        <result property="dictName" column="dict_name"/>
        <result property="dictType" column="dict_type"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="deleteTime" column="delete_time"/>
    </resultMap>

    <!-- 分页查询字典类型列表 -->
    <select id="selectDictTypeList" parameterType="com.mars.admin.modules.system.entity.SysDictType" resultMap="SysDictTypeResult">
        SELECT
            dt.id as dict_type_id,
            dt.dict_name,
            dt.dict_type,
            dt.status,
            dt.remark,
            dt.create_time,
            dt.update_time,
            dt.create_by,
            dt.update_by,
            dt.is_deleted,
            dt.delete_time
        FROM sys_dict_type dt
        WHERE dt.is_deleted = 0
        <if test="dictName != null and dictName != ''">
            AND dt.dict_name LIKE CONCAT('%', #{dictName}, '%')
        </if>
        <if test="dictType != null and dictType != ''">
            AND dt.dict_type LIKE CONCAT('%', #{dictType}, '%')
        </if>
        <if test="status != null">
            AND dt.status = #{status}
        </if>
        ORDER BY dt.create_time DESC
    </select>

    <!-- 查询字典类型详情（包含字典数据） -->
    <select id="selectDictTypeDetailById" parameterType="Long" resultMap="SysDictTypeResult">
        SELECT
            dt.id as dict_type_id,
            dt.dict_name,
            dt.dict_type,
            dt.status,
            dt.remark,
            dt.create_time,
            dt.update_time,
            dt.create_by,
            dt.update_by,
            dt.is_deleted,
            dt.delete_time
        FROM sys_dict_type dt
        WHERE dt.id = #{dictTypeId} AND dt.is_deleted = 0
    </select>

</mapper>
