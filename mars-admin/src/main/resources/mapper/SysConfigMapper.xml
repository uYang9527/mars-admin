<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mars.admin.modules.system.mapper.SysConfigMapper">

    <!-- 系统配置基础信息结果映射 -->
    <resultMap id="SysConfigResult" type="com.mars.admin.modules.system.entity.SysConfig">
        <id property="id" column="config_id"/>
        <result property="configName" column="config_name"/>
        <result property="configKey" column="config_key"/>
        <result property="configValue" column="config_value"/>
        <result property="configType" column="config_type"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="deleteTime" column="delete_time"/>
    </resultMap>

    <!-- 分页查询配置列表 -->
    <select id="selectConfigList" parameterType="com.mars.admin.modules.system.entity.SysConfig" resultMap="SysConfigResult">
        SELECT
            c.id as config_id,
            c.config_name,
            c.config_key,
            c.config_value,
            c.config_type,
            c.remark,
            c.create_time,
            c.update_time,
            c.create_by,
            c.update_by,
            c.is_deleted,
            c.delete_time
        FROM sys_config c
        WHERE c.is_deleted = 0
        <if test="configName != null and configName != ''">
            AND c.config_name LIKE CONCAT('%', #{configName}, '%')
        </if>
        <if test="configKey != null and configKey != ''">
            AND c.config_key LIKE CONCAT('%', #{configKey}, '%')
        </if>
        <if test="configType != null and configType != ''">
            AND c.config_type = #{configType}
        </if>
        ORDER BY c.create_time DESC
    </select>

</mapper>
